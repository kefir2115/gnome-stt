{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": false,
    "skipLibCheck": true,
    "outDir": ".",
    "rootDir": "./src",
    "typeRoots": ["./node_modules/@girs", "./node_modules/@types"],
    "paths": {
      "resource:///org/gnome/shell/ui/main.js": [
        "./node_modules/@girs/gnome-shell/ui/main"
      ],
      "resource:///org/gnome/shell/extensions/extension.js": [
        "./node_modules/@girs/gnome-shell/extensions/extension"
      ],
      "gi://St": ["./node_modules/@girs/st-14"],
      "gi://Clutter": ["./node_modules/@girs/clutter-14"],
      "gi://GObject": ["./node_modules/@girs/gobject-2.0"],
      "gi://GLib": ["./node_modules/@girs/glib-2.0"],
      "gi://Gio": ["./node_modules/@girs/gio-2.0"],
      "gi://Meta": ["./node_modules/@girs/meta-14"],
      "gi://Shell": ["./node_modules/@girs/shell-18"]
    }
  },
  "include": ["src/**/*"],
  "exclude": []
}
